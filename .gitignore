# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# App data: parquet cache and history catalog are rebuilt from source files
cache/
*.parquet
*.duckdb.wal

# Raw session files never belong in the repository. They contain driver names,
# team names and server names of other people (online races). Only the
# anonymised demo dataset produced by scripts/make_demo_dataset.py is tracked,
# and it lives under data/demo/.
*.duckdb
!data/demo/*.duckdb

# Generated output
export/out/
docs/screenshots/*.tmp.png

# Editors / OS / local tooling state
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
desktop.ini
